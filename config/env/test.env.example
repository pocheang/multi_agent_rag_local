SESSIONS_DIR=./.tmp/test-runtime/sessions
UPLOADS_DIR=./.tmp/test-runtime/uploads
APP_DB_PATH=./.tmp/test-runtime/app.db
HISTORY_SQLITE_PATH=./.tmp/test-runtime/history.db
RETRIEVAL_CACHE_BACKEND=memory
QUERY_GUARD_BACKEND=memory
QUERY_RESULT_CACHE_BACKEND=memory
AUTO_INGEST_ENABLED=false
