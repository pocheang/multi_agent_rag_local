# ============================================
# DEPLOYMENT & SCRIPTS (仅保留核心)
# ============================================
# 发布相关的一次性脚本/文档（防止再次出现同类噪音）
PUSH*.sh
README_PUSH.md
check_docs_for_github.sh
check_github_ready.sh
cleanup_for_github.sh

# 内部配置（保留示例配置）
config/router_calibration.json

# ============================================
# RUNTIME CONFIGURATION (完全排除)
# ============================================
# 运行时环境配置
config/env/*.env
config/profiles/*.env
!config/env/
!config/env/*.env.example
!config/profiles/*.env.example

# ============================================
# ALLOWED FILES (可以发布的)
# ============================================
# 核心文档
!README.md
!CHANGELOG.md
!LICENSE
!Makefile
!Dockerfile
!Dockerfile.*
!.dockerignore
!.gitignore

# 应用代码
!app/**/*.py
!tests/**/*.py
!scripts/**/*.py
!deploy/**/*.py
!deploy/**/*.sh

# 前端代码
!frontend/src/**
!frontend/public/**
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/.env.example

# 核心配置（仅示例）
!config/**/*.json
!config/**/*.yaml
!config/**/*.yml
!config/**/*.env.example

# Python 项目配置
!pyproject.toml
!setup.py
!setup.cfg
!requirements.txt
!requirements-*.txt

# CI/CD 配置
!.github/**/*.yml
!.github/**/*.yaml

# Docker 配置
!docker-compose.yml
!docker-compose.*.yml

# ============================================
# PUBLICATION MATRIX (发布决策参考)
# ============================================
# 已发布内容：应用源代码 (app/, frontend/src/)、测试代码 (tests/)、部署脚本示例
# (deploy/, docker-compose.yml)、配置模板 (config/**/*.example, .env.example)、
# 核心文档 (README, CHANGELOG, LICENSE)。
#
# 不发布内容：运行时数据 (data/, logs/, reports/)、内部文档 (internal_docs/,
# docs/archive/, docs/design/)、敏感配置 (*.env, config/env/*.env)、临时/调试
# 文件、AI 助手配置 (.claude/, .cursor/)。
