# ============================================
# GITHUB PUBLICATION POLICY
# ============================================
# 发布策略：只发布代码、核心配置、更新历史
# - 代码文件：.py, .js, .jsx, .ts, .tsx
# - 配置文件：.json, .yaml, .yml, .toml (仅核心配置)
# - 文档：README.md, CHANGELOG.md, LICENSE
# - 其他：全部排除

# ============================================
# SECURITY - Secrets & Credentials
# ============================================
# Environment files with secrets
.env
.env.*
!.env.example

# API keys and encryption keys
*.key
*.pem
*.p12
*.pfx

# Certificates and tokens
*.crt
*.cer
*.der
*.token
*.jwt

# Cloud provider credentials
*credentials*.json
*serviceaccount*.json
aws-credentials
gcloud-credentials

# SSH keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk

# ============================================
# DATA & RUNTIME (完全排除)
# ============================================
# 所有数据目录
data/
!data/.gitkeep

# 所有日志
logs/
*.log
*.jsonl

# 所有报告
reports/
artifacts/

# 运行时生成
.runtime/
.codex-backups/

