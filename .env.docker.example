# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=querymind
POSTGRES_USER=querymind
POSTGRES_PASSWORD=change_this_strong_password

# ============================================
# Neo4j Graph Database
# ============================================
NEO4J_PASSWORD=change_this_neo4j_password

# ============================================
# Redis Cache
# ============================================
REDIS_PASSWORD=change_this_redis_password

# ============================================
# JWT Authentication
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_random_secret_key_at_least_32_characters_long

# ============================================
# Application Environment
# ============================================
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# LLM Provider Configuration
# ============================================
# Options: openai, anthropic, ollama
MODEL_BACKEND=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_REASONING_MODEL=gpt-4

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
ANTHROPIC_REASONING_MODEL=claude-fable-5

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REASONING_MODEL=deepseek-r1:32b

# ============================================
# ChromaDB Vector Store
# ============================================
CHROMA_COLLECTION=local_rag_collection
CHROMA_PERSIST_DIR=./data/chroma

# ============================================
# RAG Configuration
# ============================================
TOP_K=4
MAX_CONTEXT_CHUNKS=6
BM25_TOP_K=6
VECTOR_TOP_K=6
HYBRID_RRF_K=60
HYBRID_VECTOR_WEIGHT=0.95

# ============================================
# n8n Workflow (Optional)
# ============================================
N8N_IMAGE=n8nio/n8n:latest
N8N_DB=n8n

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# ============================================
# File Upload Limits
# ============================================
MAX_UPLOAD_SIZE=100
MAX_UPLOADS_PER_REQUEST=10
