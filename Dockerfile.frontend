# Multi-stage build for QueryMind Frontend
FROM node:20-alpine as builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --ignore-scripts

# Copy source code
COPY frontend/ ./

# Allow deployment to configure the browser-side API prefix.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Build the application
RUN npm run build

# Production stage with nginx.
#
# nginxinc/nginx-unprivileged is nginx's own image for running as a normal
# user (docker:S6471): uid 101, and it cannot bind a privileged port, so the
# container listens on 8080 and the host mapping does the translation.
# nginx.conf, the healthcheck below and compose.production.yaml all had to
# move together -- a listen directive left at 80 fails to bind, silently as
# far as the build is concerned.
FROM nginxinc/nginx-unprivileged:alpine

# That image ends on `USER 101`, so a COPY here would run as a user that cannot
# write /usr/share/nginx/html or /etc/nginx/conf.d. Back to root for the copies
# and out again -- the documented pattern for this image, and the reason a
# straight base-image swap does not work.
USER root

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

USER 101

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/ || exit 1

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
