"""
Web Activity Admin Authentication & Authorization

管理API的认证和权限控制中间件。

功能：
- API Key认证
- JWT Token认证
- 基于角色的权限控制
- 访问日志记录
"""

import logging
from datetime import datetime, timedelta
from typing import Optional, List
from functools import wraps

from fastapi import HTTPException, Security, Depends, Header
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
import jwt
from passlib.context import CryptContext

logger = logging.getLogger(__name__)

# 密码加密
pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")

# JWT配置
SECRET_KEY = "your-secret-key-change-this-in-production"  # 生产环境请修改
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 60

# HTTP Bearer认证
security = HTTPBearer()


class Role:
    """用户角色"""
    ADMIN = "admin"
    MANAGER = "manager"
    VIEWER = "viewer"


class User:
    """用户模型"""
    def __init__(self, username: str, role: str, api_key: Optional[str] = None):
        self.username = username
        self.role = role
        self.api_key = api_key


# 模拟用户数据库（生产环境应使用真实数据库）
# 密码已预先hash（使用bcrypt）
USERS_DB = {
    "admin": {
        "username": "admin",
        "hashed_password": "$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LewY5GyYqVr/2lnK.",  # admin123
        "role": Role.ADMIN,
        "api_key": "admin-api-key-12345"
    },
    "manager": {
        "username": "manager",
        "hashed_password": "$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LewY5GyYqVr/2lnK.",  # manager123
        "role": Role.MANAGER,
        "api_key": "manager-api-key-67890"
    },
    "viewer": {
        "username": "viewer",
        "hashed_password": "$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LewY5GyYqVr/2lnK.",  # viewer123
        "role": Role.VIEWER,
        "api_key": "viewer-api-key-abcde"
    }
}


def verify_password(plain_password: str, hashed_password: str) -> bool:
    """验证密码"""
    return pwd_context.verify(plain_password, hashed_password)


def get_password_hash(password: str) -> str:
    """密码加密"""
    return pwd_context.hash(password)


def create_access_token(data: dict, expires_delta: Optional[timedelta] = None) -> str:
    """
    创建JWT Token

    Args:
        data: Token数据
        expires_delta: 过期时间

    Returns:
        JWT Token字符串
    """
    to_encode = data.copy()
    if expires_delta:
        expire = datetime.utcnow() + expires_delta
    else:
        expire = datetime.utcnow() + timedelta(minutes=ACCESS_TOKEN_EXPIRE_MINUTES)

    to_encode.update({"exp": expire})
    encoded_jwt = jwt.encode(to_encode, SECRET_KEY, algorithm=ALGORITHM)
    return encoded_jwt


def verify_token(token: str) -> Optional[dict]:
    """
    验证JWT Token

    Args:
        token: JWT Token

    Returns:
        解码后的数据，或None
    """
    try:
        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
        return payload
    except jwt.PyJWTError:
        return None


def authenticate_user(username: str, password: str) -> Optional[User]:
    """
    用户认证

    Args:
        username: 用户名
        password: 密码

    Returns:
        User对象，或None
    """
    user_data = USERS_DB.get(username)
    if not user_data:
        return None

    if not verify_password(password, user_data["hashed_password"]):
        return None

    return User(
        username=user_data["username"],
        role=user_data["role"],
        api_key=user_data.get("api_key")
    )


def verify_api_key(api_key: str) -> Optional[User]:
    """
    验证API Key

    Args:
        api_key: API密钥

    Returns:
        User对象，或None
    """
    for user_data in USERS_DB.values():
        if user_data.get("api_key") == api_key:
            return User(
                username=user_data["username"],
                role=user_data["role"],
                api_key=user_data["api_key"]
            )
    return None


# FastAPI依赖函数

async def get_current_user_token(
    credentials: HTTPAuthorizationCredentials = Security(security)
) -> User:
    """
    从JWT Token获取当前用户

    Args:
        credentials: HTTP Bearer凭证

    Returns:
        User对象

    Raises:
        HTTPException: 认证失败
    """
    token = credentials.credentials
    payload = verify_token(token)

    if payload is None:
        raise HTTPException(
            status_code=401,
            detail="Invalid authentication credentials",
            headers={"WWW-Authenticate": "Bearer"},
        )

    username = payload.get("sub")
    if username is None:
        raise HTTPException(status_code=401, detail="Invalid token")

    user_data = USERS_DB.get(username)
    if user_data is None:
        raise HTTPException(status_code=401, detail="User not found")

    return User(
        username=user_data["username"],
        role=user_data["role"],
        api_key=user_data.get("api_key")
    )


async def get_current_user_api_key(
    x_api_key: Optional[str] = Header(None)
) -> User:
    """
    从API Key获取当前用户

    Args:
        x_api_key: API密钥（HTTP Header）

    Returns:
        User对象

    Raises:
        HTTPException: 认证失败
    """
    if x_api_key is None:
        raise HTTPException(
            status_code=401,
            detail="API Key required",
            headers={"WWW-Authenticate": "ApiKey"},
        )

    user = verify_api_key(x_api_key)
    if user is None:
        raise HTTPException(status_code=401, detail="Invalid API Key")

    logger.info(f"API Key authentication: user={user.username}, role={user.role}")
    return user


async def get_current_user(
    token_user: Optional[User] = Depends(get_current_user_token),
    api_key_user: Optional[User] = Depends(get_current_user_api_key)
) -> User:
    """
    获取当前用户（支持Token或API Key）

    优先使用Token，如果Token无效则尝试API Key

    Args:
        token_user: 从Token获取的用户
        api_key_user: 从API Key获取的用户

    Returns:
        User对象

    Raises:
        HTTPException: 认证失败
    """
    # 优先Token
    if token_user:
        return token_user

    # 后备API Key
    if api_key_user:
        return api_key_user

    raise HTTPException(
        status_code=401,
        detail="Authentication required",
        headers={"WWW-Authenticate": "Bearer"},
    )


def require_role(allowed_roles: List[str]):
    """
    角色权限装饰器

    Args:
        allowed_roles: 允许的角色列表

    Returns:
        依赖函数
    """
    async def check_role(user: User = Depends(get_current_user)):  # 改用get_current_user支持JWT
        if user.role not in allowed_roles:
            logger.warning(f"Access denied: user={user.username}, role={user.role}, required={allowed_roles}")
            raise HTTPException(
                status_code=403,
                detail=f"Insufficient permissions. Required role: {', '.join(allowed_roles)}"
            )
        return user

    return check_role


# 预定义的权限依赖

async def require_admin(user: User = Depends(get_current_user)) -> User:
    """要求Admin角色"""
    if user.role != Role.ADMIN:
        raise HTTPException(status_code=403, detail="Admin access required")
    return user


async def require_manager(user: User = Depends(get_current_user)) -> User:
    """要求Manager或Admin角色"""
    if user.role not in [Role.ADMIN, Role.MANAGER]:
        raise HTTPException(status_code=403, detail="Manager access required")
    return user


async def require_viewer(user: User = Depends(get_current_user)) -> User:
    """要求Viewer、Manager或Admin角色（任何认证用户）"""
    # 所有认证用户都可以查看
    return user


# 访问日志记录

class AccessLogger:
    """访问日志记录器"""

    @staticmethod
    def log_access(user: User, endpoint: str, method: str, success: bool = True):
        """
        记录API访问

        Args:
            user: 用户对象
            endpoint: API端点
            method: HTTP方法
            success: 是否成功
        """
        log_entry = {
            "timestamp": datetime.now().isoformat(),
            "username": user.username,
            "role": user.role,
            "endpoint": endpoint,
            "method": method,
            "success": success
        }

        if success:
            logger.info(f"API Access: {user.username} ({user.role}) -> {method} {endpoint}")
        else:
            logger.warning(f"API Access Failed: {user.username} ({user.role}) -> {method} {endpoint}")

        # TODO: 可以写入专门的访问日志文件
        # with open("logs/api_access.log", "a") as f:
        #     f.write(json.dumps(log_entry) + "\n")


# 使用示例（在路由中）
"""
from app.api.auth import require_admin, require_manager, get_current_user_api_key

# 要求Admin权限
@router.get("/admin-only", dependencies=[Depends(require_admin)])
async def admin_endpoint():
    return {"message": "Admin access granted"}

# 要求Manager权限
@router.get("/manager-only", dependencies=[Depends(require_manager)])
async def manager_endpoint():
    return {"message": "Manager access granted"}

# 任何认证用户
@router.get("/protected")
async def protected_endpoint(user: User = Depends(get_current_user_api_key)):
    return {"message": f"Hello {user.username}"}

# 使用API Key认证
curl -H "X-API-Key: admin-api-key-12345" http://localhost:8000/api/v1/admin/web-activity/stats
"""
