  "pages": {
    "landing": {
      "heroSubtitle": "Enterprise-grade, local-first intelligent Q&A engine with multi-agent orchestration, hybrid retrieval, graph enhancement, and streaming chat.",
      "enterApp": "Enter Console",
      "register": "Register",
      "learnMore": "Learn More",
      "featuresSubtitle": "A look at the production-ready components that power our enterprise intelligent search engine.",
      "feature1Title": "Multi-Agent Orchestration",
      "feature1Desc": "Built on LangGraph. Intelligently routes queries across Router, Vector RAG, Graph RAG, Web Research, and Synthesis agents for precise answers.",
      "feature2Title": "Hybrid Retrieval Engine",
      "feature2Desc": "Blends dense vector search (ChromaDB) and sparse BM25 retrieval using Reciprocal Rank Fusion (RRF), followed by BGE-reranker cross-encoding.",
      "feature3Title": "Knowledge Graph Enrichment",
      "feature3Desc": "Queries Neo4j knowledge graphs to match entities and retrieve multi-hop relationships, unlocking deep relational reasoning and context.",
      "feature4Title": "Document Processing & OCR",
      "feature4Desc": "True streaming PDF processing with 70% memory reduction, OCR (Tesseract) for scanned documents, and parallel chart/image captioning.",
      "feature5Title": "Operations & Governance",
      "feature5Desc": "Controls query profiles (Fast/Balanced/Deep), Canary routing for A/B testing, prompt version control/rollback, and query replay.",
      "feature6Title": "Enterprise Security & Isolation",
      "feature6Desc": "RBAC permissions, audit logging, constant-time token comparison, rate limiting, and strictly isolated user-scoped session databases.",
      "workflowTitle": "Request Execution Flow",
      "workflowSubtitle": "How queries are processed securely, analyzed, routed, retrieved, and synthesized.",
      "ctaTitle": "Ready to Unlock Your Local Knowledge?",
      "ctaSubtitle": "Deploy a secure, powerful, and private multi-agent copilot in minutes."
    },
