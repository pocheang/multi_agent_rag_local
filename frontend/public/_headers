# Security headers for production deployment
/*
  # Content Security Policy - Restricts resource loading to prevent XSS
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http://localhost:8000 http://127.0.0.1:8000; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

  # Prevent clickjacking attacks
  X-Frame-Options: SAMEORIGIN

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Enable XSS protection in browsers
  X-XSS-Protection: 1; mode=block

  # Force HTTPS for 1 year (enable in production only)
  # Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable browser features that could be exploited
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
