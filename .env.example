# ===========================================
# QueryMind Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control
#
# Quick Start:
#   1. cp .env.example .env
#   2. Edit .env with your configuration
#   3. For full options, see: config/env/base.env.example

# ===========================================
# Application Settings
# ===========================================
APP_ENV=dev

# ===========================================
# Model Backend Configuration
# ===========================================
# Options: ollama, openai, anthropic, deepseek, custom
MODEL_BACKEND=ollama
REASONING_MODEL_BACKEND=

# Ollama Configuration (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REASONING_MODEL=deepseek-r1:32b

# OpenAI Configuration (required if MODEL_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_REASONING_MODEL=gpt-4-thinking

# Anthropic Configuration (required if MODEL_BACKEND=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-4-8
ANTHROPIC_REASONING_MODEL=claude-opus-4-8

# ===========================================
# Database Configuration
# ===========================================
# Neo4j (optional, for graph RAG features)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# PostgreSQL (optional, for multi-user features)
POSTGRES_PASSWORD=

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===========================================
# Security Keys (REQUIRED)
# ===========================================
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'

# Encryption key for API settings storage
API_SETTINGS_ENCRYPTION_KEY=

# JWT secret for authentication tokens
JWT_SECRET_KEY=

# Admin user creation approval token
ADMIN_CREATE_APPROVAL_TOKEN=

# ===========================================
# Data & Storage
# ===========================================
DATA_DIR=./data/docs
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=local_rag_collection
CORPUS_STORE_PATH=./data/chunks/chunks.jsonl
PARENT_STORE_PATH=./data/chunks/parents.jsonl

# ===========================================
# Retrieval Configuration
# ===========================================
# Basic settings
TOP_K=4
MAX_CONTEXT_CHUNKS=6
VECTOR_TOP_K=6
BM25_TOP_K=6

# Similarity thresholds
VECTOR_SIMILARITY_THRESHOLD=0.2
VECTOR_SIMILARITY_RELAXED_THRESHOLD=0.05

# Reranking
ENABLE_RERANKER=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5

# Caching
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=45
RETRIEVAL_CACHE_MAX_ITEMS=256

# ===========================================
# Rate Limiting (queries per hour)
# ===========================================
QUERY_RATE_LIMIT_ADMIN=100
QUERY_RATE_LIMIT_PREMIUM=60
QUERY_RATE_LIMIT_USER=30

# ===========================================
# Advanced Features
# ===========================================
# Query processing
QUERY_REWRITE_ENABLED=true
QUERY_DECOMPOSE_ENABLED=true
DYNAMIC_RETRIEVAL_ENABLED=true

# Circuit breaker
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Web research (optional)
WEB_DOMAIN_ALLOWLIST=gov.cn,gov,edu,org,wikipedia.org,owasp.org

# Graph RAG (requires Neo4j)
GRAPH_RAG_ENHANCED=false
GRAPH_EXTRACTION_MODE=llm

# ===========================================
# Performance & Monitoring
# ===========================================
QUERY_REQUEST_TIMEOUT_MS=60000
STREAM_HEARTBEAT_SECONDS=6
OTEL_TRACING_ENABLED=true

# SLO thresholds
SLO_P95_LATENCY_MS_THRESHOLD=3000
SLO_ERROR_RATE_PERCENT_THRESHOLD=5
SLO_GROUNDING_SUPPORT_RATIO_THRESHOLD=0.6

# ===========================================
# File Upload Configuration
# ===========================================
UPLOAD_MAX_FILES=20
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_TOTAL_BYTES=104857600

# OCR settings (optional)
TESSERACT_CMD=
TESSERACT_LANG=chi_sim+eng
PEOPLE_DETECTION_ENABLED=true

# ===========================================
# Authentication Settings
# ===========================================
AUTH_TOKEN_TTL_HOURS=24
AUTH_LOGIN_MAX_FAILURES=8
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REGISTER_MAX_ATTEMPTS=12
AUTH_REGISTER_WINDOW_SECONDS=300

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/callback

# ===========================================
# Data Privacy & Security
# ===========================================
# Outbound data redaction
OUTBOUND_LLM_REDACTION_ENABLED=true
OUTBOUND_EMBEDDING_REDACTION_ENABLED=true

# Custom redaction patterns (comma-separated)
OUTBOUND_REDACTION_CUSTOM_TERMS=
OUTBOUND_REDACTION_CUSTOM_REGEXES=

# API base URL validation
API_BASE_URL_ALLOWLIST=
API_BASE_URL_ALLOW_PRIVATE=false
API_BASE_URL_DNS_CHECK=true

# ===========================================
# Development Settings
# ===========================================
# Auto-ingest (watch for new documents)
AUTO_INGEST_ENABLED=false
AUTO_INGEST_INTERVAL_SECONDS=3
AUTO_INGEST_WATCH_DOCS=true

# Session storage
SESSIONS_DIR=./data/sessions
UPLOADS_DIR=./data/uploads

# Database paths
APP_DB_PATH=./data/app.db
USERS_FILE=./data/security/users.json
AUTH_SESSIONS_FILE=./data/security/auth_sessions.json

# ===========================================
# For complete configuration options, see:
# - config/env/base.env.example
# - docs/getting-started/setup.md
# ===========================================
