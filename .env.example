# ==============================================
# RAG System Environment Configuration
# ==============================================

# ==============================================
# MODEL BACKEND CONFIGURATION
# ==============================================
# Options: "local", "openai", "anthropic", "ollama"
# - local: Offline mode (no API key needed, limited functionality)
# - openai: OpenAI GPT models
# - anthropic: Anthropic Claude models
# - ollama: Local Ollama models

MODEL_BACKEND=local

# ==============================================
# OPENAI CONFIGURATION (if MODEL_BACKEND=openai)
# ==============================================
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_CHAT_MODEL=gpt-5.5
# OPENAI_REASONING_MODEL=gpt-5.5
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================
# ANTHROPIC CONFIGURATION (if MODEL_BACKEND=anthropic)
# ==============================================
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_CHAT_MODEL=claude-sonnet-5
# ANTHROPIC_REASONING_MODEL=claude-fable-5

# ==============================================
# OLLAMA CONFIGURATION (if MODEL_BACKEND=ollama)
# ==============================================
# Install Ollama from: https://ollama.ai/download
# Then run: ollama pull qwen3:14b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3:14b
# OLLAMA_REASONING_MODEL=deepseek-r1:32b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DATABASE_URL=sqlite:///./data/querymind.db

# Session Metadata Storage Backend
# Options: "memory", "database"
# - memory: In-memory storage (fast, volatile, lost on restart)
# - database: SQLite storage (persistent, production-ready)
SESSION_METADATA_BACKEND=database

# ==============================================
# MULTI-MODAL PROCESSING
# ==============================================
# Enable/disable multi-modal features
ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_EXTRACTION=true
ENABLE_OCR=true

# Vision Models for Image Understanding
VISION_MODEL=gpt-4-vision-preview
MAX_IMAGE_TOKENS=1000

# OCR Configuration
OCR_ENGINE=tesseract  # tesseract|paddleocr
OCR_LANGUAGES=eng+chi_sim

# Multi-modal Retrieval Fusion
MULTIMODAL_FUSION_METHOD=rrf  # rrf|weighted
IMAGE_WEIGHT=0.3
TABLE_WEIGHT=0.3
TEXT_WEIGHT=0.4

# ==============================================
# VECTOR STORE CONFIGURATION
# ==============================================
CHROMA_PERSIST_DIR=./data/chroma

# ==============================================
# RERANKER CONFIGURATION
# ==============================================
# Enable semantic reranking for better retrieval quality
ENABLE_RERANKER=true
# Model: BAAI/bge-reranker-v2-m3 (requires local download)
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5

# ==============================================
# NEO4J GRAPH DATABASE (Optional)
# ==============================================
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password

# ==============================================
# REDIS CONFIGURATION (Optional, for rate limiting)
# ==============================================
# REDIS_URL=redis://localhost:6379/0

# ==============================================
# QUERY ANALYSIS & CLARIFICATION
# ==============================================
QUERY_ANALYSIS_MIN_CONFIDENCE=0.7
QUERY_COMPLEXITY_SIMPLE_THRESHOLD=10
QUERY_COMPLEXITY_COMPLEX_THRESHOLD=30
CLARIFICATION_MAX_ROUNDS=10
CLARIFICATION_MIN_CONFIDENCE=0.85

# ==============================================
# ADVANCED REASONING (ReAct Multi-hop)
# ==============================================
TOOL_RUNNER_MAX_ITERATIONS=5
# TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ==============================================
# PERFORMANCE OPTIMIZATION
# ==============================================
# Multi-level Caching
CACHE_L2_ENABLED=false  # Set to true when Redis is available
CACHE_L1_SIZE=256
CACHE_L1_TTL=300  # 5 minutes
CACHE_L2_TTL=3600  # 1 hour
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Retrieval Optimization
RETRIEVAL_BATCH_SIZE=10
RETRIEVAL_MAX_CONCURRENT=5
RETRIEVAL_PROFILE=advanced

# ==============================================
# APPLICATION SETTINGS
# ==============================================
APP_ENV=development
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true

# ==============================================
# SECURITY - API KEY ENCRYPTION (必需)
# ==============================================
# 用于加密存储在数据库中的API密钥和敏感配置
# 生成方法: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# ⚠️ 警告：一旦设置后不要更改，否则已加密的数据将无法解密
# API_SETTINGS_ENCRYPTION_KEY=

# SHA-256 of the one-time administrator approval token.
# Generate both values without storing the raw token here:
# python -c "import hashlib,secrets; t=secrets.token_urlsafe(48); print('token:',t); print('hash:',hashlib.sha256(t.encode()).hexdigest())"
# ADMIN_CREATE_APPROVAL_TOKEN_HASH=

# HMAC response/audit signing. Required when APP_ENV=production and signing is enabled.
RESPONSE_SIGNING_ENABLED=true
RESPONSE_SIGNING_ACTIVE_KID=v1
RESPONSE_SIGNING_KEYS=
# RESPONSE_SIGNING_SECRET=

# ==============================================
# AUTHENTICATION & SESSION SETTINGS
# ==============================================
# 会话令牌有效期（小时）
AUTH_TOKEN_TTL_HOURS=168  # 7天

# 登录失败限制
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300  # 5分钟

# 注册限制
AUTH_REGISTER_MAX_ATTEMPTS=3
AUTH_REGISTER_WINDOW_SECONDS=3600  # 1小时

# SQLite数据库超时配置（秒）
SQLITE_BUSY_TIMEOUT_SECONDS=10

# Google OAuth（可选）
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ==============================================
# QUICK START EXAMPLES
# ==============================================

# Example 1: OpenAI GPT-4
# MODEL_BACKEND=openai
# OPENAI_API_KEY=sk-proj-xxxxx
# OPENAI_CHAT_MODEL=gpt-5.5

# Example 2: Anthropic Claude
# MODEL_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# Example 3: Local Ollama (Free)
# MODEL_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen3:14b

# Example 4: Development (No API key needed)
# MODEL_BACKEND=local
